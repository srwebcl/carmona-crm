# --- Base de datos ---
# PostgreSQL (default — Neon vía Vercel Marketplace: `vercel integration add neon`,
# provisiona DATABASE_URL automáticamente):
DATABASE_URL="postgresql://usuario:password@host/nombre_bd?sslmode=require"
# Si se autoaloja en Cloudways con MySQL en cambio:
# DATABASE_URL="mysql://usuario:password@host:3306/nombre_bd"
# y cambiar `provider = "postgresql"` a `"mysql"` en prisma/schema.prisma
# (ver README, sección "Motor de base de datos").

# --- Sesión / autenticación ---
# Secreto usado para firmar la cookie de sesión (JWT). Generar uno único y
# largo por entorno, por ejemplo con: openssl rand -base64 32
SESSION_SECRET="cambia-este-valor-por-uno-aleatorio-largo"

# --- Correo saliente (alertas de SLA, notificaciones de nuevo reclamo y de
# resolución) — vía Resend (https://resend.com) ---
# Opcional: sin RESEND_API_KEY el mailer solo deja log en consola (ver src/lib/mailer.ts).
RESEND_API_KEY="re_..."
MAIL_FROM="Reclamos Carmona <reclamos@carmonaycia.cl>"
# Admin principal: recibe copia de todo reclamo nuevo, además del
# responsable asignado automáticamente (ver src/lib/claimCreation.ts).
ADMIN_EMAIL="cbolados@carmonaycia.cl"
# Correo(s) adicionales en copia para TODO correo saliente (opcional)
ALERTS_CC=""

# --- Alertas de SLA ---
# Horas de reloj corrido sin gestión antes de disparar la alerta por correo
# y de contar un reclamo como atrasado.
SLA_HOURS="48"
# Secreto que valida que /api/cron/sla-check lo llama Vercel Cron (no aplica
# si se autoaloja en Cloudways, ahí el cron corre dentro del propio proceso).
# Generar con: openssl rand -hex 32
CRON_SECRET="cambia-este-valor-por-uno-aleatorio-largo"

# --- URL pública de la app (usada en enlaces dentro de los correos) ---
APP_URL="http://localhost:3000"

# --- Adjuntos ---
# En Vercel: definir BLOB_READ_WRITE_TOKEN (la provisiona automáticamente
# `vercel blob store add`) y listo, no hace falta nada más acá.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Autoalojado (Cloudways, sin Vercel Blob): ruta ABSOLUTA en el servidor
# donde se guardan los adjuntos. Debe quedar FUERA de la carpeta del build
# (.next/), porque el servidor standalone hace chdir() a esa carpeta al
# arrancar y su contenido se reemplaza en cada `next build`/despliegue.
# Requerida en producción si no hay BLOB_READ_WRITE_TOKEN.
# Ejemplo en Cloudways: /home/master/applications/<app_id>/uploads
UPLOADS_DIR="/ruta/absoluta/persistente/uploads"
