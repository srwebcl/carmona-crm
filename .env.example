# --- Base de datos ---
# MySQL (default en Cloudways):
DATABASE_URL="mysql://usuario:password@host:3306/nombre_bd"
# Si la cuenta de Cloudways provee Postgres en cambio, usar:
# DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd"
# y cambiar `provider = "mysql"` a `"postgresql"` en prisma/schema.prisma.

# --- Sesión / autenticación ---
# Secreto usado para firmar la cookie de sesión (JWT). Generar uno único y
# largo por entorno, por ejemplo con: openssl rand -base64 32
SESSION_SECRET="cambia-este-valor-por-uno-aleatorio-largo"

# --- Correo saliente (alertas de SLA, notificaciones de resolución) ---
SMTP_HOST="smtp.tu-proveedor.cl"
SMTP_PORT="587"
SMTP_USER="reclamos@carmona.cl"
SMTP_PASS="clave-smtp"
SMTP_FROM="Reclamos Carmona <reclamos@carmona.cl>"
# Correo(s) adicionales en copia para toda alerta de SLA vencido (opcional)
ALERTS_CC=""

# --- Alertas de SLA ---
# Días hábiles sin gestión antes de disparar la alerta por correo.
SLA_BUSINESS_DAYS="5"

# --- URL pública de la app (usada en enlaces dentro de los correos) ---
APP_URL="http://localhost:3000"

# --- Adjuntos ---
# Ruta ABSOLUTA en el servidor donde se guardan los archivos adjuntos a los
# reclamos. Debe quedar FUERA de la carpeta del build (.next/), porque el
# servidor standalone hace chdir() a esa carpeta al arrancar y su contenido
# se reemplaza en cada `next build`/despliegue. Requerida en producción.
# Ejemplo en Cloudways: /home/master/applications/<app_id>/uploads
UPLOADS_DIR="/ruta/absoluta/persistente/uploads"
